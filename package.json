{
  "name": "vertex-city",
  "version": "3.0.0-preview",
  "description": "A real city, drawn as light: surveyed OpenStreetMap geometry rendered four ways, with an astronomically correct sky and live data layers.",
  "type": "module",
  "license": "MIT",
  "author": "Christopher Davis",
  "scripts": {
    "start": "PORT=$(portbroker get --name vertex-city || portbroker alloc --name vertex-city) node dev-server.mjs",
    "worker:dev": "wrangler dev",
    "worker:deploy": "wrangler deploy",
    "benchmark": "node tools/benchmark-engine.js",
    "test": "node --test --test-concurrency=2 test/*.test.js",
    "lint": "eslint .",
    "check": "npm run lint && npm test",
    "browser:check": "node tools/browser-v3.mjs",
    "shader:check": "node tools/shader-check.mjs",
    "media": "node tools/capture-media.mjs"
  },
  "keywords": [
    "openstreetmap",
    "webgl",
    "wireframe",
    "ascii",
    "city",
    "renderer",
    "astronomy"
  ],
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "eslint": "^9.34.0",
    "globals": "^16.3.0",
    "wrangler": "^4.32.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tweakyourpc/vertex-city.git"
  }
}
